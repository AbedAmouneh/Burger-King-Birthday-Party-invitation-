# Copy to .env.local and fill in. .env.local is gitignored.

# Supabase project settings -> Data API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase project settings -> API keys -> service_role (secret).
# Server-only: used solely by the admin delete server action.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. Gate for the #royal admin view.
ADMIN_PASSPHRASE=

# Optional. Only needed if the site gets a custom domain: it makes the
# WhatsApp share card's image URL absolute. On Vercel this is inferred.
NEXT_PUBLIC_SITE_URL=
